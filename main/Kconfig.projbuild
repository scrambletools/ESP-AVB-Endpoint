menu "AVB Example Configuration"
    
    config EXAMPLE_AVB_ENTITY_NAME
        string "Entity Name"
        default "AVB Example Entity"
        help
            Set the name of the AVB entity. This name will be used 
            to identify this device in the AVB network.

    config EXAMPLE_AVB_MODEL_ID
        hex "Model ID"
        default 0x0000007468696e67
        help
            Set the model ID for this AVB entity. This ID should uniquely identify 
            the model/type of AVB device within your vendor's product line.

    config EXAMPLE_AVB_TALKER
        bool "Enable AVB Talker"
        default y
        help
            Function as AVB Talker.

    config EXAMPLE_AVB_SAMPLE_RATE
        int "Media sample rate (Hz)"
        default 48000
        help
            Boot-time sample rate for the audio streams and media clock.
            Use 48000, 96000 or 192000; the effective rate is limited by
            the selected codec's capabilities.

    config EXAMPLE_AVB_TALKER_AUTO_STREAM
        bool "Auto Stream"
        depends on EXAMPLE_AVB_TALKER
        default n
        help
            Automatically start streaming when link is up. (not implemented yet)
      
    choice EXAMPLE_SELECT_MIC_GAIN
        prompt "Default MIC gain"
        depends on EXAMPLE_AVB_TALKER
        default MIC_GAIN_36DB if EXAMPLE_AVB_CODEC_ES8389_HAT
        default MIC_GAIN_6DB
        help
            Select a codec-independent default mic gain. The AVB component
            clamps and rounds this to the nearest value supported by the
            selected codec. Mic-level sources (e.g. an XLR microphone on
            the ES8389 hat's combo jack) need most of the PGA range; a
            6 dB default leaves speech ~30 dB below visible meter level.

        config MIC_GAIN_0DB
            bool "0 dB"
        config MIC_GAIN_6DB
            bool "6 dB"
        config MIC_GAIN_12DB
            bool "12 dB"
        config MIC_GAIN_18DB
            bool "18 dB"
        config MIC_GAIN_24DB
            bool "24 dB"
        config MIC_GAIN_30DB
            bool "30 dB"
        config MIC_GAIN_36DB
            bool "36 dB"
    endchoice
      
    config EXAMPLE_AVB_MIC_GAIN_TENTH_DB
        depends on EXAMPLE_AVB_TALKER
        int
        default 0 if MIC_GAIN_0DB
        default 60 if MIC_GAIN_6DB
        default 120 if MIC_GAIN_12DB
        default 180 if MIC_GAIN_18DB
        default 240 if MIC_GAIN_24DB
        default 300 if MIC_GAIN_30DB
        default 360 if MIC_GAIN_36DB

    config EXAMPLE_AVB_LISTENER
        bool "Enable AVB Listener"
        default y
        help
            Function as AVB Listener.

    config EXAMPLE_AVB_LISTENER_AUTO_CONNECT
        bool "Auto Connect"
        depends on EXAMPLE_AVB_LISTENER
        default n
        help
            Automatically connect to an AVB Talker with the same entity model ID. (not implemented yet)
      
    config EXAMPLE_AVB_SPEAKER_VOL_TENTH_DB
        int "Default speaker volume (tenths of dB)"
        depends on EXAMPLE_AVB_LISTENER
        range -955 0
        default -100
        help
            Set a codec-independent default speaker digital volume in tenths
            of dB. For example, -100 is -10.0 dB and 0 is 0.0 dB. The AVB
            component clamps and rounds this to the nearest value supported
            by the selected codec.

    config EXAMPLE_AVB_REMOTE_CONTROL
        bool "Allow remote control via ATDECC"
        default y
        help
            Allow an AVB Controller to control this device via ATDECC protocol. If not set it will break Milan compliance.

    config EXAMPLE_AVB_CODEC_DISABLED
        bool "Skip codec + I2S init (control plane only)"
        default n
        help
            Set avb_config.codec_disabled=true so I2S and codec init
            are skipped. Use on boards where the wired codec does not
            match the default (e.g. an ES8388 hat on a P4-ETH host
            where the default selection is ES8311). The control plane
            — ATDECC, MSRP, MVRP, MAAP — runs unaffected; only audio
            I/O is disabled. Used for control-plane reproduction
            tests on hosts without matching audio hardware.

    config EXAMPLE_AVB_CODEC_ES8389_HAT
        bool "Use ES8389 Scramble Hat (overrides ES8311 onboard default)"
        default n
        depends on !EXAMPLE_AVB_CODEC_DISABLED
        help
            Use the Scramble Hat ES8389 codec instead of the onboard
            ES8311. Overrides avb_config.codec_type to
            avb_codec_type_es8389 and remaps codec_pins to the Scramble
            Hat layout for the pinout revision selected below (both maps
            documented in esp_avb/avbconfig.h). Boards: ESP32-P4-ETH
            fitted with the Scramble Hat, directly or via the Synthia
            eurorack interposer (its crossover preserves the same
            carrier GPIO map).

    choice EXAMPLE_AVB_ES8389_HAT_PINOUT
        prompt "Scramble Hat pinout revision"
        depends on EXAMPLE_AVB_CODEC_ES8389_HAT
        default EXAMPLE_AVB_ES8389_HAT_PINOUT_V3
        help
            Mezzanine pinout revision of the fitted hat. v3 boards
            (produced 2026-07) use the original pin map. v4 boards use
            the 2026-08 dual-host (ESP32-P4 + Raspberry Pi Pico)
            revision: I2C moved to the J3 signal row, BCLK/LRCK made
            adjacent, MCLK/DET moved to J4.6/J4.7. Selecting the wrong
            revision gives a silent codec (I2C lands on I2S pins) —
            check the revision marking on the board.

        config EXAMPLE_AVB_ES8389_HAT_PINOUT_V3
            bool "v3 (MCLK=16 BCLK=17 WS=19 DOUT=18 DIN=54 SDA=21 SCL=20)"

        config EXAMPLE_AVB_ES8389_HAT_PINOUT_V4
            bool "v4 (MCLK=20 BCLK=17 WS=16 DOUT=18 DIN=15 SDA=54 SCL=19)"
    endchoice

    config AVB_ENDPOINT_PERF_TEST_MODE
        bool "Perf-test mode (skip PTP/AVB/codec, count matching AVTP frames on WiFi STA)"
        default n
        depends on ESP_PTP_PORT0_MEDIUM_WIFI_FTM || ESP_PTP_PORT1_MEDIUM_WIFI_FTM
        help
            Replaces the production bring-up. Only NVS + esp_event + WiFi
            STA come up; ptpd, AVB and the codec are NOT started. An
            esp_wifi_internal_reg_rxcb hook counts AVTP frames whose
            dest MAC + stream ID match the configured pair. A 1 Hz
            stats task logs pps and Mbps. Pair with
            CONFIG_AVB_BRIDGE_PERF_TEST_MODE on the bridge to measure
            end-to-end throughput across SDIO + 802.11.

            Visible only on builds where a WiFi STA medium is configured
            (the C6 wireless endpoint build).

    config AVB_ENDPOINT_PERF_TEST_DEST_MAC
        string "Test destination MAC (six colon-separated hex octets)"
        default "91:e0:f0:00:fe:00"
        depends on AVB_ENDPOINT_PERF_TEST_MODE
        help
            Must match the bridge perf-test mode's DEST_MAC. Frames with
            any other dest MAC are dropped at the filter and counted
            separately so a mis-pair is visible in the heartbeat.

    config AVB_ENDPOINT_PERF_TEST_STREAM_ID
        string "Test AVTP stream ID (eight colon-separated hex octets)"
        default "80:f1:b2:d2:ca:e0:00:01"
        depends on AVB_ENDPOINT_PERF_TEST_MODE
        help
            Must match the bridge perf-test mode's STREAM_ID. Frames
            with any other stream_id are dropped at the filter.

    config AVB_ENDPOINT_PERF_TEST_TX_MODE
        bool "Perf-test direction: TRANSMIT (uplink) instead of receive"
        default n
        depends on AVB_ENDPOINT_PERF_TEST_MODE
        help
            Default (n) is the receive role: count AVTP frames arriving
            from the bridge's SoftAP (downlink). Set y to invert the
            role and blast AVTP-shaped frames at the AP instead, so the
            STA->AP (uplink) direction can be measured with the same
            esp_wifi_internal_tx path the bridge uses downlink.

            Uplink and downlink are not symmetric. Per IEEE 802.11
            Table 9-30, a To-DS frame carries Address 1 = BSSID, an
            individual address, even when the MSDU is group addressed,
            so uplink group traffic is ACKed and retried while downlink
            group traffic is not. Whether the driver actually exploits
            that is what this mode exists to measure. Pair with
            CONFIG_AVB_BRIDGE_PERF_TEST_RX_MODE on the bridge.

    config AVB_ENDPOINT_PERF_TEST_FIX_RATE
        int "Force a fixed PHY rate for TX (-1 = driver rate control)"
        default -1
        range -1 255
        depends on AVB_ENDPOINT_PERF_TEST_TX_MODE
        help
            Value is a wifi_phy_rate_t, passed to
            esp_wifi_internal_set_fix_rate(). -1 leaves the driver's own
            rate control in charge.

            Exists to test whether the driver's group-addressed TX
            throttle is rate selection rather than queueing: group
            addressed frames are conventionally sent at a basic rate,
            and 234 B at 1 Mbps is ~1.9 ms, i.e. a ceiling near 500 pps,
            which is the order actually measured. Forcing e.g. 0x17
            (MCS7, long GI, 65 Mbps HT20) separates the two causes.

            Note esp_wifi_internal_set_fix_rate returns
            ESP_ERR_NOT_SUPPORTED while TX AMPDU is enabled, so pair
            this with CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n, and note the
            fixed rate applies to ALL frames on the interface, not just
            group addressed ones.

    config AVB_ENDPOINT_PERF_TEST_TX_PAYLOAD_BYTES
        int "TX payload bytes after the 24-byte AVTP header"
        default 192
        range 0 1400
        depends on AVB_ENDPOINT_PERF_TEST_TX_MODE
        help
            Matches the bridge's PAYLOAD_BYTES default so uplink and
            downlink numbers are directly comparable.

    config AVB_ENDPOINT_PERF_TEST_TX_INTERVAL_US
        int "TX inter-packet interval microseconds (0 = back-to-back)"
        default 0
        range 0 1000000
        depends on AVB_ENDPOINT_PERF_TEST_TX_MODE

    config AVB_ENDPOINT_PERF_TEST_TX_DURATION_SEC
        int "TX duration seconds (0 = run forever)"
        default 30
        range 0 86400
        depends on AVB_ENDPOINT_PERF_TEST_TX_MODE

    config AVB_ENDPOINT_PERF_TEST_DURATION_SEC
        int "Test duration seconds (0 = run forever)"
        default 10
        range 0 86400
        depends on AVB_ENDPOINT_PERF_TEST_MODE
        help
            Counted from the first matching RX. After expiry the stats
            task prints a one-line summary and stops sampling; the WiFi
            stack stays up so re-running the bridge side just needs a
            board reset on the bridge.

    config EXAMPLE_AVB_OLED_DISPLAY
        bool "Status OLED display (SSD1306 on the codec I2C bus)"
        default n
        help
            Drive a small SSD1306 OLED as a stream-status indicator.
            Idle, it shows the last two octets of the endpoint MAC
            (e.g. 92:20). When input streams are active it shows IN,
            when output streams are active OUT, and IN OUT when both
            are. The panel shares the codec I2C bus; units without a
            panel fitted skip the feature at the address probe.

    config EXAMPLE_AVB_OLED_I2C_ADDR
        hex "OLED I2C address"
        default 0x3C
        depends on EXAMPLE_AVB_OLED_DISPLAY
        help
            7-bit I2C address of the SSD1306 controller. Common
            modules use 0x3C, some 0x3D.

    choice EXAMPLE_AVB_OLED_GEOMETRY
        prompt "OLED panel geometry"
        default EXAMPLE_AVB_OLED_128X64
        depends on EXAMPLE_AVB_OLED_DISPLAY

        config EXAMPLE_AVB_OLED_128X64
            bool "128x64"
        config EXAMPLE_AVB_OLED_128X32
            bool "128x32"
        config EXAMPLE_AVB_OLED_64X32
            bool "64x32 (0.49 inch module)"
    endchoice

endmenu
