# A board with an ESP-Hosted Wi-Fi coprocessor: the Waveshare
# ESP32-P4-WIFI6-POE-ETH's onboard ESP32-C6 over 4-bit SDIO, slot 1, on
# esp-hosted's P4 default pins (the wiring ESP-AVB-Bridge documents).
# Add after sdkconfig.defaults:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi_coprocessor" build
CONFIG_EXAMPLE_WIFI_COPROCESSOR=y
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE=y

# Reset the coprocessor on every boot, but carry on without it: unlike
# the bridge, an endpoint keeps working over Ethernet when the
# coprocessor doesn't come up or fails later.
CONFIG_ESP_HOSTED_HOST_CP_RESET_STRATEGY_ALWAYS=y
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_ON_TIMEOUT_NONE=y
# CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE is not set

# The coprocessor's firmware upload is kept in PSRAM. Caps-only
# allocation, as for the echo canceller: malloc stays in internal RAM,
# so nothing on the stream path moves to PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
